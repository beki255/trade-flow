{
  "expo": {
    "name": "TradeFlow Mobile",
    "slug": "tradeflow-mobile",
    "owner": "bereket2553",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tradeflow.mobile"
    },
    "android": {
      "package": "com.tradeflow.mobile",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "d6d1fb37-0051-409e-96b3-d382667ef8b1"
      }
    }
  }
}
