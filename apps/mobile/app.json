{
  "expo": {
    "name": "TradeFlow Mobile",
    "slug": "tradeflow-mobile",
    "owner": "bereket2553",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tradeflow.mobile"
    },
    "android": {
      "package": "com.tradeflow.mobile",
      "versionCode": 13,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "https://tradeflow-api-7abs.onrender.com",
      "eas": {
        "projectId": "d6d1fb37-0051-409e-96b3-d382667ef8b1"
      }
    }
  }
}